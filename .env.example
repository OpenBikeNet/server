# OpenBikeNet server configuration. Copy to .env (`make setup` does this) and adjust.
# Every value is optional; the defaults below are used when a line is missing.
# After an update, `make setup` (also run by `make up` and `make update`) adds
# settings that are new here to the end of your .env and leaves the rest alone.

# --- Network -----------------------------------------------------------------

# Host interface and port for the WebSocket and the stats endpoint.
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from the network.
OBN_HTTP_BIND=127.0.0.1
OBN_HTTP_PORT=8090

# Behind a reverse proxy (Caddy, nginx, Traefik): take client IPs from
# X-Forwarded-For (1 or true). Set it to 1 behind the bundled Caddy or your own
# proxy, and only when the proxy is the only way in. 0 = off.
OBN_TRUST_PROXY=0

# Log level: error, warn, info, debug, trace (RUST_LOG syntax).
RUST_LOG=info

# --- HTTPS (bundled Caddy, optional) -----------------------------------------
# Not needed when your own reverse proxy terminates TLS (see the README).
# For a public server, point a DNS record at it, then enable Caddy:
#
#   COMPOSE_PROFILES=tls
#   OBN_DOMAIN=net.example.org
#
# Caddy obtains a Let's Encrypt certificate automatically (ports 80 and 443).
# Also set OBN_TRUST_PROXY=1 above.
#COMPOSE_PROFILES=tls
OBN_DOMAIN=

# --- Build -------------------------------------------------------------------
OBN_IMAGE_TAG=local
