# Local settings for `make dev`: copy to .env.dev (gitignored) and adjust.
# `make dev` runs cargo on 127.0.0.1:8090; these override its defaults.

# Where the server stores its usage statistics.
OBN_DB=obn.sqlite

# Routes from the protocol submodule.
OBN_ROUTES_DIR=protocol/routes

# Log level (RUST_LOG syntax).
RUST_LOG=info,obn_server=debug
